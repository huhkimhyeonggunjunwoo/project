# Production. Put real values in .env.production.local (git-ignored)
# or in the host's environment variables.
APP_ENV=production
DATABASE_PATH=data/prod.db
# Origin(s) the web client is served from, e.g. ["https://onehouse.example.com"]
CORS_ORIGINS='["https://onehouse.cse.ac"]'
HISTORY_PAGE_SIZE=30
MAX_MESSAGE_LENGTH=1000
# The agent (Claude). Set ANTHROPIC_API_KEY in .env.production.local or the host env.
AGENT_NAME=one
AGENT_MODEL=claude-sonnet-5-5
AGENT_CONTEXT_MESSAGES=50

MEMORY_PATH=data/wiki-prod
